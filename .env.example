# Public browser configuration. The anon key is safe to expose only when RLS is enabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional single-owner guard shown before sign-in. Never put a password here.
VITE_OWNER_EMAIL=owner@example.com
